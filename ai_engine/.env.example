# IBVAP AI Engine Service Configuration

# Service Host & Port
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# Shared Authentication Token between AI Engine and Go Backend
AI_SERVICE_TOKEN=ibvap_secret_service_token_2026

# Go Backend Event Webhook URL
BACKEND_AI_EVENT_URL=http://localhost:8080/api/v1/ai/events
CAMERA_ID=1


# Headless / GUI Mode (false for production server without desktop display)
DISPLAY_ENABLED=false

# Directory for saving evidence images and incident clips
EVIDENCE_DIRECTORY=events

# Logging & Reconnect Settings
LOG_LEVEL=INFO
RECONNECT_DELAY=3.0
MAX_RECONNECT_ATTEMPTS=10
