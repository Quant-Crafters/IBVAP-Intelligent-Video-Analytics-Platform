# Development uses Vite's proxy. For a separately deployed frontend, set this
# to the public backend API URL (for example, https://api.example.com/api).
VITE_API_BASE_URL=/api

# Optional: backend origin used by the Vite development proxy.
VITE_BACKEND_URL=http://localhost:8080

# Optional: only needed if health is exposed somewhere other than <API base>/../health.
# VITE_HEALTH_URL=http://localhost:8080/health
