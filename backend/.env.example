SERVER_PORT=8080

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

JWT_SECRET=

UPLOAD_DIR=uploads

# Python AI engine. Keep this token private and use the same value in ai_engine/.env.
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call this API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173
